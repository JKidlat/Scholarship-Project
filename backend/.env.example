# ============================================================
# Ghana Scholarship Portal — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000

# Supabase — use your project's values from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
