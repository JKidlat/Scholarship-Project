# ============================================================
# Ghana Scholarship Portal — Environment Configuration Example
# ============================================================
# Copy this file to .env.local for local development.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER place sensitive private keys or service role keys in client files.

# --- Public Client Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
VITE_SITE_URL=http://localhost:3000
VITE_SITE_NAME="Ghana Scholarship Portal"

# --- Backend / CI / Deployment Only (DO NOT PREFIX WITH VITE_) ---
# These are used in serverless backend functions or CI pipelines only.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_admin_scripts_only
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=noreply@ghanascholarships.gov.gh
